# Example crowd-flow dataset: keep only one representative video for the
# example scripts; the rest of the original UCF Crowd Segmentation dataset
# is too large to version and isn't needed beyond that one demo clip.
data/UCF_CrowdsDataset/*.mov
!data/UCF_CrowdsDataset/3687-18_70.mov

